rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // GLOBAL AUTH & RBAC HELPERS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function schoolId() {
      return request.auth.token.schoolId;
    }

    function districtId() {
      return request.auth.token.districtId;
    }

    function userRole() {
      return (request.auth != null && request.auth.token != null && 'role' in request.auth.token) ? request.auth.token.role : 'unknown';
    }

    // Role checks
    function isSuperAdmin() { return userRole() == 'super_admin'; }
    function isSchoolAdmin() { return userRole() == 'school_admin'; }
    function isPrincipal() { return userRole() == 'principal'; }
    function isTeacher() { return userRole() == 'teacher'; }
    function isStudent() { return userRole() == 'student'; }
    function isParent() { return userRole() == 'parent'; }

    // User checks
    function isSelf(userId) { return isAuthenticated() && request.auth.uid == userId; }

    // Tenant boundary checks
    // Super admins bypass tenant boundaries
    function isTenantUser(targetSchoolId) {
      return isAuthenticated() && (schoolId() == targetSchoolId || isSuperAdmin());
    }

    // ==========================================
    // VALIDATION HELPERS
    // ==========================================

    // Ensure a field is not being changed during an update
    function notUpdating(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    // Validate a timestamp is the exact server time (no future dates)
    function isServerTimestamp(field) {
      return request.resource.data[field] == request.time;
    }

    // Check if operation is a soft delete
    function isSoftDelete() {
      return request.resource.data.isArchived == true;
    }

    // Protect core immutable fields from any client modification
    function protectedImmutableFields() {
      return notUpdating('schoolId') && notUpdating('createdAt') && notUpdating('uid');
    }

    // Protect server-authoritative fields from client modification
    function protectedServerFields() {
      return notUpdating('totalPoints') && notUpdating('rank') && notUpdating('subscriptionPlan');
    }

    // Validate creation schema
    function isValidCreationSchema(targetSchoolId) {
      return request.resource.data.schoolId == targetSchoolId &&
             (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
    }

    // Validate update schema
    function isValidUpdateSchema() {
      return true;
    }


    // ==========================================
    // TENANT BOUNDARY: /schools/{schoolId}
    // ==========================================
    match /schools/{targetSchoolId} {
      
      allow read: if isTenantUser(targetSchoolId);
      allow create: if isSuperAdmin();
      allow update: if isTenantUser(targetSchoolId) && (isSchoolAdmin() || isSuperAdmin())
                    && protectedImmutableFields()
                    && protectedServerFields();
      allow delete: if false;

      // Users Collection
      match /users/{userId} {
        allow read: if isTenantUser(targetSchoolId) && (request.auth.uid == userId || isTeacher() || isPrincipal() || isSchoolAdmin() || isSuperAdmin());
        allow create: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Roles Collection
      match /roles/{roleId} {
        allow read: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin());
        allow create: if isSuperAdmin();
        allow update: if isTenantUser(targetSchoolId) && (isSchoolAdmin() || isSuperAdmin()) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Students Collection
      match /students/{studentId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isTeacher() || isSchoolAdmin() || isPrincipal() || isSuperAdmin())
                      && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isTeacher() || isSchoolAdmin() || isPrincipal() || isSuperAdmin())
                      && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Activities Collection
      match /activities/{activityId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isTeacher() || isPrincipal() || isSuperAdmin())
                      && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isTeacher() || isPrincipal() || isSuperAdmin())
                      && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Point Transactions Collection (IMMUTABLE AUDIT TRAIL)
      match /point_transactions/{txId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isTeacher() || isPrincipal() || isSuperAdmin())
                      && isValidCreationSchema(targetSchoolId);
        allow update: if false; // Strict immutability, only Cloud Functions/SuperAdmin can change
        allow delete: if isSuperAdmin();
      }

      // Houses Collection
      match /houses/{houseId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isSchoolAdmin() || isPrincipal() || isSuperAdmin())
                      && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isSchoolAdmin() || isPrincipal() || isSuperAdmin())
                      && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Categories (using legacy 'categorys' path pending migration)
      match /categorys/{categoryId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Deliveries (using legacy 'deliverys' path pending migration)
      match /deliverys/{deliveryId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Announcements
      match /announcements/{announcementId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isTeacher() || isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isTeacher() || isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Schedulings
      match /schedulings/{documentId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Broadcasts
      match /broadcasts/{documentId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // WhatsApp Templates
      match /whatsapptemplates/{documentId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Communication Groups
      match /communicationgroups/{documentId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Templates
      match /templates/{documentId} {
        allow read: if isTenantUser(targetSchoolId);
        allow create: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Preferences
      match /preferences/{userId} {
        allow read: if isTenantUser(targetSchoolId) && (isSelf(userId) || isSuperAdmin());
        allow create: if isTenantUser(targetSchoolId) && (isSelf(userId) || isSuperAdmin()) && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isSelf(userId) || isSuperAdmin()) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      
      // Leaderboards
      match /leaderboards/{document=**} {
        allow read: if isTenantUser(targetSchoolId);
        allow write: if isSuperAdmin();
      }
      
      // Analytics
      match /analytics/{document=**} {
        allow read: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin());
        allow write: if isSuperAdmin();
      }
      
      // Dashboard Metrics (KPI)
      match /dashboard_metrics/{document=**} {
        allow read: if isTenantUser(targetSchoolId) && (isPrincipal() || isSchoolAdmin() || isSuperAdmin());
        allow write: if isSuperAdmin();
      }
      
      // Notifications
      match /notifications/{notificationId} {
        allow read: if isTenantUser(targetSchoolId) && (isSuperAdmin() || !('userId' in resource.data) || resource.data.userId == request.auth.uid);
        allow create: if isTenantUser(targetSchoolId) && (isTeacher() || isPrincipal() || isSchoolAdmin() || isSuperAdmin()) && isValidCreationSchema(targetSchoolId);
        allow update: if isTenantUser(targetSchoolId) && (isSuperAdmin() || resource.data.userId == request.auth.uid || (!('userId' in resource.data) && (isPrincipal() || isSchoolAdmin()))) && isValidUpdateSchema();
        allow delete: if isSuperAdmin();
      }

      // Fallback for unhandled subcollections (Default Deny)
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
